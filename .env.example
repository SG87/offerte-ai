# Kopieer naar .env en vul in. Zonder ANTHROPIC_API_KEY draait alles,
# maar de AI-functies (foto-analyse, skill-vertaling, bedrijfsherkenning)
# vallen terug op handmatige invoer / heuristieken.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# App
OFFERTE_SECRET_KEY=change-me-in-production
OFFERTE_DATABASE_URL=sqlite:///./data/offerte.db
OFFERTE_DATA_DIR=./data
OFFERTE_BASE_URL=http://localhost:8000

# MCP (v1, dev): de organisatie waarvoor de MCP-server werkt, op e-mail.
OFFERTE_MCP_ORG_EMAIL=

# Hostnamen die de HTTP-MCP-transport aanvaardt (DNS-rebinding-bescherming). Voeg je tunnel-host toe
# als je /mcp openzet voor de Claude-app, bv. "localhost:*,127.0.0.1:*,abc.trycloudflare.com".
OFFERTE_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,localhost,127.0.0.1
