# Kopieer naar .env en vul in. Zonder ANTHROPIC_API_KEY draait alles,
# maar de AI-functies (foto-analyse, skill-vertaling, bedrijfsherkenning)
# vallen terug op handmatige invoer / heuristieken.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# App
OFFERTE_SECRET_KEY=change-me-in-production
OFFERTE_DATABASE_URL=sqlite:///./data/offerte.db
OFFERTE_DATA_DIR=./data
OFFERTE_BASE_URL=http://localhost:8000

# MCP (v1, dev): de organisatie waarvoor de MCP-server werkt, op e-mail.
OFFERTE_MCP_ORG_EMAIL=

# Hostnamen die de HTTP-MCP-transport aanvaardt (DNS-rebinding-bescherming). Voeg je tunnel-host toe
# als je /mcp openzet voor de Claude-app, bv. "localhost:*,127.0.0.1:*,abc.trycloudflare.com".
OFFERTE_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,localhost,127.0.0.1

# Mail: offertes naar klanten, bestelvoorstellen en bestellingen. Zonder SMTP-host blijven mails in de outbox
# (te lezen in de historiek van het project). Poort 465 = SSL, anders STARTTLS. Gmail/Workspace: app-wachtwoord.
OFFERTE_SMTP_HOST=
OFFERTE_SMTP_PORT=587
OFFERTE_SMTP_USER=
OFFERTE_SMTP_PASSWORD=
OFFERTE_SMTP_FROM=
# Afzendernaam van alle mails ("Offer AI <OFFERTE_SMTP_FROM>"); antwoorden gaan naar het e-mailadres van het bedrijf.
OFFERTE_MAIL_FROM_NAME=Offer AI
# Testmodus: alle mails gaan naar dit adres in plaats van naar de echte ontvangers. Leeg = echt versturen.
OFFERTE_MAIL_REDIRECT_TO=

# Triggers voor de voorraad-agent en de planningstool (voorraad.controle, werk.inplannen) worden als JSON
# naar deze URL gePOST, ondertekend met HMAC-SHA256 in X-Offerte-Signature. Leeg = ophalen via GET /api/v1/events.
OFFERTE_WEBHOOK_URL=
OFFERTE_WEBHOOK_SECRET=
# (Zie README: de verantwoordelijke voorraad en de planner duid je aan bij Contacten → Werknemers.)

# Peppol (B2B-facturen): API van je access point; leeg = UBL downloaden en zelf opladen
OFFERTE_PEPPOL_API_URL=
OFFERTE_PEPPOL_API_KEY=

# Afstand tot de werf (kilometervergoeding): OpenStreetMap Nominatim + OSRM. false = afstand zelf invullen.
OFFERTE_GEO_ENABLED=true
# OFFERTE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# OFFERTE_ROUTER_URL=https://router.project-osrm.org
