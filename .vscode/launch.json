{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Web app (uvicorn, reload)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "jinja": true,
      "console": "integratedTerminal"
    },
    {
      "name": "MCP server (stdio)",
      "type": "debugpy",
      "request": "launch",
      "module": "app.mcp_server",
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Demo: offerte uit voorbeeldgeometrie",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/demo_quote.py",
      "args": ["tests/fixtures/sample_geometry.json"],
      "envFile": "${workspaceFolder}/.env",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Tests (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
